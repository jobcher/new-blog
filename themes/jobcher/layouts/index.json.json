[
{{- $pages := where site.RegularPages "Section" "in" (slice "blog" "new") -}}
{{- range $i, $p := $pages -}}
{{- if $i }},{{ end }}
{"title":{{ $p.Title | jsonify }},"url":{{ $p.RelPermalink | jsonify }},"date":{{ $p.Date.Format "2006-01-02" | jsonify }},"summary":{{ $p.Summary | plainify | truncate 120 | jsonify }},"categories":{{ $p.Params.categories | jsonify }},"tags":{{ $p.Params.tags | jsonify }}}
{{- end -}}
]
